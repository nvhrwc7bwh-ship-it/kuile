-- ============================================================================
-- 亏了 · 正式上线版 · 环境变量清单
-- ----------------------------------------------------------------------------
-- 【小白须知】这个文件是「所有需要你自己去申请、填写的密钥」清单。
--   每个密钥都要去对应的网站申请，填进来。
--   部署时复制为 .env 并填写。**不要把填好的 .env 发给别人。**
--
-- 【怎么用】
--   1. 复制本文件为 .env：  cp .env.example .env
--   2. 逐项填写（每项后面都写了去哪儿申请）
--   3. 填完后执行： chmod 600 .env
-- ============================================================================

# ---------------------------------------------------------------------------
# 一、服务基本信息
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# 你的后端对外域名（腾讯云服务器绑定的域名，如 api.yourdomain.com）
# ⚠️ 必须是 HTTPS，微信小程序正式版强制要求
API_BASE_URL=https://api.yourdomain.com
# 小程序 appid（微信公众平台 → 开发管理 → 开发设置）
WECHAT_APPID=wx_your_appid_here
# 小程序 appsecret（同一页面，别泄露）
WECHAT_APPSECRET=your_appsecret_here

# ---------------------------------------------------------------------------
# 二、数据库（自建 MySQL 8.0，和后端在同一台服务器上）
# ---------------------------------------------------------------------------
# 【小白须知】本项目用的是【自建 MySQL】，不是腾讯云托管数据库。
#   数据库就跑在这台服务器上，只监听 127.0.0.1（不对公网开放），
#   所以这里填 127.0.0.1 就行，不需要配置任何数据库安全组。
#
#   【库和账号从哪来？】第 4 章「自建数据库」里会用命令创建：
#     CREATE DATABASE kuile CHARACTER SET utf8mb4;
#     CREATE USER 'kuile'@'localhost' IDENTIFIED BY '你的密码';
#     GRANT ALL PRIVILEGES ON kuile.* TO 'kuile'@'localhost';
#
# 【⚠️ 时区】服务器和 MySQL 的时区必须统一设成 UTC，
#   否则「断卡判定」「结束日结算」的日期边界会算错一天。
#   见第 4 章「4.5 校准时区」。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kuile
DB_USER=kuile
DB_PASSWORD=your_db_password_here
DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# 三、对象存储（腾讯云 COS）—— 存照片
# ---------------------------------------------------------------------------
COS_REGION=ap-guangzhou
COS_BUCKET=kuile-prod-1250000000
COS_SECRET_ID=your_cos_secret_id_here
COS_SECRET_KEY=your_cos_secret_key_here
# 访问密钥的临时令牌（可选，开了临时密钥时用）
COS_SESSION_TOKEN=
# COS 访问域名，用于拼接图片 URL
COS_CDN_URL=https://kuile-prod-1250000000.cos.ap-guangzhou.myqcloud.com

# ---------------------------------------------------------------------------
# 四、AI 模型（豆包 / 火山方舟）
# ----------------------------------------------------------------------------
# 用于打卡照片判定：读秤面读数、判读手写词、检查照片是否有效
# ---------------------------------------------------------------------------
# 火山方舟 API Key（火山引擎控制台 → 开通服务 → API Key 管理）
ARK_API_KEY=your_ark_api_key_here
# 接入点 ID（不是模型名！控制台里「开通管理」→ 推理接入点 → 复制 Endpoint ID）
ARK_ENDPOINT_ID=ep-xxxxxxxxxxxxxxxx
# 模型名（纯模型调用时用，接入点模式可留空）
ARK_MODEL=doubao-1-5-vision-pro-250528
# 是否启用 AI 判定。false = 人工/规则兜底，上线初期建议保持 false 观察
AI_VERIFY_ENABLED=true
# 单次判定超时（毫秒）
AI_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# 五、微信支付（押金）
# ----------------------------------------------------------------------------
# ⚠️ 上线前必须在微信支付商户平台完成全部认证，未认证无法开通
# ---------------------------------------------------------------------------
# 【押金总开关】—— 内测阶段保持 false，正式收押金时改成 true
#   false = 内测阶段，暂不收取押金
#       · 押金档位照常显示、照常选（界面不变）
#       · 点「确认并支付」不调微信支付，弹提示「内测阶段，暂不收取押金」
#       · 结算时不扣收、不退款
#   true = 正式收押金（走微信支付全套流程）
# 改完这一行要重启服务才生效：pm2 restart kuile-api
DEPOSIT_ENABLED=false

WECHAT_PAY_MCH_ID=1900000000
WECHAT_PAY_SERIAL_NO=your_cert_serial_no_here
WECHAT_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WECHAT_PAY_PRIVATE_KEY=your_private_key_here
WECHAT_PAY_API_V3_KEY=your_api_v3_key_32_chars_here
WECHAT_PAY_NOTIFY_URL=https://api.yourdomain.com/api/pay/notify
WECHAT_PAY_PLATFORM_CERT=your_platform_cert_here

# ---------------------------------------------------------------------------
# 六、登录令牌
# ---------------------------------------------------------------------------
# 随机长字符串，用于签发登录态。生成方法见《上线执行清单》
JWT_SECRET=please_change_this_to_a_random_64_char_string
TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# 七、推送（腾讯云 TPNS）
# ---------------------------------------------------------------------------
TPNS_ENABLED=false
TPNS_ACCESS_ID=your_tpns_access_id_here
TPNS_ACCESS_KEY=your_tpns_access_key_here

# ---------------------------------------------------------------------------
# 八、日志
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=./logs

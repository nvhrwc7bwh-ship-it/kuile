/* 亏了 · 见证席面板专属样式 */

.intro-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.intro-sub {
  display: block;
  font-size: 25rpx;
  color: #6B6560;
}

/* 节点 */
.node-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.node-title {
  font-size: 30rpx;
  font-weight: 600;
}

.node-sub {
  display: block;
  font-size: 23rpx;
  color: #6B6560;
  margin-bottom: 16rpx;
}

.votes {
  margin-bottom: 20rpx;
}

.vote {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
}

.v-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #EFECE7;
  color: #1F5F4E;
  font-size: 22rpx;
  text-align: center;
  line-height: 48rpx;
  flex-shrink: 0;
}

.v-name {
  flex: 1;
  font-size: 25rpx;
}

.v-dec {
  font-size: 23rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.v-dec.ok { background: rgba(31, 95, 78, 0.10); color: #1F5F4E; }
.v-dec.bad { background: rgba(179, 38, 30, 0.10); color: #B3261E; }
.v-dec.mid { background: rgba(194, 87, 26, 0.10); color: #C2571A; }

/* 任务列表 */
.task-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.task-title {
  flex: 1;
  font-size: 29rpx;
  font-weight: 600;
}

.task-sub {
  display: block;
  font-size: 23rpx;
  color: #6B6560;
  margin-top: 6rpx;
}

.nodes-mini {
  display: flex;
  margin-top: 18rpx;
}

.nm {
  flex: 1;
  text-align: center;
}

.nm-name {
  display: block;
  font-size: 21rpx;
  color: #6B6560;
}

.nm-dec {
  display: block;
  font-size: 23rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.nm-dec.ok { color: #1F5F4E; }
.nm-dec.bad { color: #B3261E; }
.nm-dec.mid { color: #C2571A; }
.nm-dec.none { color: #9A938A; }

/* 判定弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #F7F5F2;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.sheet-sub {
  display: block;
  font-size: 23rpx;
  color: #6B6560;
  margin: 6rpx 0 24rpx;
}

.dec-list {
  margin-bottom: 20rpx;
}

.dec {
  padding: 22rpx 24rpx;
  border: 2rpx solid #E5E1DB;
  border-radius: 16rpx;
  margin-bottom: 14rpx;
  background: #FFFFFF;
}

.dec-t {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.dec-d {
  display: block;
  font-size: 22rpx;
  color: #6B6560;
  margin-top: 2rpx;
}

.dec.on-pass { border-color: #1F5F4E; background: rgba(31, 95, 78, 0.05); }
.dec.on-cheat { border-color: #B3261E; background: rgba(179, 38, 30, 0.05); }
.dec.on-doubt { border-color: #C2571A; background: rgba(194, 87, 26, 0.05); }

.sheet .textarea {
  margin-bottom: 20rpx;
}

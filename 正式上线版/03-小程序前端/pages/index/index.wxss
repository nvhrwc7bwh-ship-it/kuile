/* 亏了 · 首页专属样式（对齐 demo 的 homeEmpty / homePrep / 进行中） */

/* ---------- 顶部导航（demo: navBig('亏了')） ---------- */

.navbar-big {
  height: 116rpx;
  align-items: center;
}

.navbar-brand {
  flex: 1;
  font-size: 58rpx;
  font-weight: 760;
  letter-spacing: -1.4rpx;
  color: #1C1613;
  line-height: 1.2;
}

.nav-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(17, 19, 24, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-btn:active {
  transform: scale(0.9);
  background: rgba(17, 19, 24, 0.11);
}

.nav-btn-q {
  font-size: 30rpx;
  font-weight: 700;
  color: #857A6F;
  line-height: 1;
}

/* ---------- 空态卡片（demo: .empty-hero） ---------- */

.empty-hero {
  margin-top: 12rpx;
}

.empty-cta {
  margin-top: 40rpx;
  gap: 12rpx;
}

/* ---------- 主卡（demo: .hero） ---------- */

.hero {
  position: relative;
  overflow: hidden;
  border-radius: 52rpx;
  background: linear-gradient(150deg, #FF9A3D 0%, #FF6B00 42%, #E85A00 100%);
  color: #FFFFFF;
  padding: 40rpx;
  margin: 12rpx 36rpx 24rpx;
  box-shadow: 0 28rpx 72rpx rgba(255, 107, 0, 0.4);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.hero-label {
  font-size: 23rpx;
  opacity: 0.72;
  letter-spacing: 1.6rpx;
  font-weight: 600;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 200rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 23rpx;
  font-weight: 600;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 730;
  margin: 16rpx 0 8rpx;
  letter-spacing: -0.8rpx;
  line-height: 1.3;
  position: relative;
  z-index: 1;
}

.hero-sub {
  display: block;
  font-size: 26rpx;
  opacity: 0.8;
  line-height: 1.5;
  position: relative;
  z-index: 1;
}

/* 三个体重数字 */
.hero-weight {
  display: flex;
  margin: 36rpx 0 28rpx;
  position: relative;
  z-index: 1;
}

.hw-item {
  flex: 1;
  text-align: center;
}

.hw-v {
  display: block;
  font-size: 44rpx;
  font-weight: 750;
  letter-spacing: -1rpx;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.hw-u {
  display: block;
  font-size: 21rpx;
  opacity: 0.78;
  margin-top: 6rpx;
}

/* 进度条 */
.hero-progress {
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.24);
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.hero-progress-bar {
  height: 100%;
  background: #FFFFFF;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.hero-progress-label {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 23rpx;
  opacity: 0.86;
  position: relative;
  z-index: 1;
}

/* ---------- 筹备期倒计时（demo: .prep-clock-block） ---------- */

.prep-hero {
  background: linear-gradient(150deg, #F0E9E1 0%, #E6DACF 100%);
  color: #1C1613;
  box-shadow: 0 8rpx 24rpx rgba(74, 52, 32, 0.09);
}

.prep-hero .hero-badge {
  background: rgba(255, 255, 255, 0.7);
  color: #A97108;
}

.prep-hero .hero-label {
  color: #857A6F;
  opacity: 1;
}

.prep-hero .hero-sub {
  color: #857A6F;
  opacity: 1;
}

.prep-clock {
  margin-top: 32rpx;
  padding: 32rpx 24rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.66);
  text-align: center;
  position: relative;
  z-index: 1;
}

.prep-clock-label {
  display: block;
  font-size: 24rpx;
  color: #857A6F;
  font-weight: 550;
}

.prep-clock-value {
  display: block;
  font-size: 76rpx;
  font-weight: 780;
  letter-spacing: -2rpx;
  line-height: 1.15;
  margin: 8rpx 0;
  color: #C2571A;
  font-variant-numeric: tabular-nums;
}

.prep-clock-note {
  display: block;
  font-size: 23rpx;
  color: #857A6F;
  line-height: 1.6;
}

/* ---------- 筹备期招人区（demo: .prep-actions） ---------- */

.prep-actions {
  margin: 0 36rpx 24rpx;
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 4rpx rgba(74, 52, 32, 0.04), 0 8rpx 24rpx rgba(74, 52, 32, 0.06);
}

.prep-actions-title {
  display: block;
  font-size: 30rpx;
  font-weight: 680;
  color: #1C1613;
}

.prep-actions-sub {
  display: block;
  font-size: 24rpx;
  color: #857A6F;
  line-height: 1.6;
  margin: 12rpx 0 24rpx;
}

.prep-btn {
  margin-top: 16rpx;
  gap: 12rpx;
}

/* ---------- 加载中 ---------- */

.loading {
  text-align: center;
  color: #B3A79A;
  font-size: 26rpx;
  padding: 60rpx 0;
}

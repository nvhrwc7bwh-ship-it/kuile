/* 亏了 · 通知页专属样式 */

.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 16rpx 32rpx 24rpx;
}

.head-title {
  font-size: 40rpx;
  font-weight: 700;
}

.head-sub {
  font-size: 25rpx;
  color: #1F5F4E;
}

.filters {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 20rpx;
}

.filter {
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  color: #6B6560;
  font-size: 25rpx;
}

.filter.on {
  background: #1F5F4E;
  color: #FFFFFF;
}

.notif-list {
  padding: 0 32rpx;
}

.notif {
  position: relative;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.notif.unread {
  background: rgba(31, 95, 78, 0.04);
}

.notif-dot {
  position: absolute;
  top: 28rpx;
  right: 24rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  background: #B3261E;
}

.notif-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
  padding-right: 30rpx;
}

.notif-content {
  display: block;
  font-size: 25rpx;
  color: #6B6560;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.loading {
  text-align: center;
  color: #9A938A;
  font-size: 26rpx;
  padding: 40rpx 0;
}

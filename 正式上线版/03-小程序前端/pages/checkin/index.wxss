/* 亏了 · 打卡页专属样式 */

.day-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.day-label {
  font-size: 26rpx;
  color: #6B6560;
}

.day-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #1F5F4E;
  margin: 0 8rpx;
}

.tip {
  display: block;
  margin: 8rpx 0 20rpx;
}

/* 照片框 */
.photo-box {
  width: 100%;
  height: 480rpx;
  border-radius: 20rpx;
  background: #EFECE7;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  text-align: center;
}

.photo-icon {
  display: block;
  font-size: 72rpx;
  margin-bottom: 12rpx;
}

.photo-text {
  font-size: 28rpx;
  color: #6B6560;
}

/* 判定结果 */
.result-card {
  text-align: center;
}

.result-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  margin: 0 auto 20rpx;
  font-size: 48rpx;
  line-height: 88rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.result-icon.ok { background: #1F5F4E; }
.result-icon.no { background: #C2571A; }

.result-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.result-reason {
  display: block;
  font-size: 26rpx;
  color: #6B6560;
  margin-bottom: 24rpx;
}

<view class="page">
  <view class="status-bar"></view>

  <!-- 导航 -->
  <view class="navbar">
    <view class="navbar-back" bindtap="goFlag">‹</view>
    <text class="navbar-title">今日打卡</text>
    <view class="navbar-back"></view>
  </view>

  <block wx:if="{{flag}}">
    <!-- 打卡的是哪一天 -->
    <view class="card day-card">
      <view>
        <text class="day-label">第</text>
        <text class="day-num">{{dayIndex}}</text>
        <text class="day-label">天 / 共 {{flag.days}} 天</text>
      </view>
      <text class="tag {{flag.dayNow == dayIndex ? 'tag-orange' : 'tag-green'}}">
        {{flag.dayNow == dayIndex ? '今天' : '补卡'}}
      </text>
    </view>

    <!-- 判定结果 -->
    <view class="card result-card" wx:if="{{result}}">
      <view class="result-icon {{result.ok ? 'ok' : 'no'}}">{{result.ok ? '✓' : '!'}}</view>
      <text class="result-title">{{result.ok ? '打卡通过' : '这张照片没通过'}}</text>
      <text class="result-reason">{{result.verdict}}</text>
      <button class="btn btn-ghost btn-sm" bindtap="retake" wx:if="{{!result.ok}}">重拍一张</button>
    </view>

    <!-- 拍照 -->
    <view class="card">
      <text class="card-title">① 打卡照片</text>
      <text class="t-muted t-small tip">照片里必须能清楚看到：体重秤读数 + 手写词</text>

      <view class="photo-box" bindtap="takePhoto">
        <image wx:if="{{photoPath}}" class="photo-img" src="{{photoPath}}" mode="aspectFill"></image>
        <view wx:else class="photo-placeholder">
          <text class="photo-icon">📷</text>
          <text class="photo-text">点击拍照</text>
        </view>
      </view>
    </view>

    <!-- 表单 -->
    <view class="card">
      <text class="card-title">② 填写内容</text>

      <view class="field">
        <text class="label">体重秤读数（kg）</text>
        <input class="input" type="digit" placeholder="例：63.5"
               value="{{weight}}" bindinput="onWeightInput" />
      </view>

      <view class="field">
        <text class="label">手写词</text>
        <input class="input" placeholder="今天写什么？例：坚持"
               value="{{handwrite}}" bindinput="onHandwriteInput" />
        <text class="t-muted t-small tip">在纸上写一个词，拍进照片里</text>
      </view>
    </view>

    <!-- 提交 -->
    <view class="pad">
      <button class="btn btn-primary" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">
        {{submitting ? '正在判定…' : '提交打卡'}}
      </button>
    </view>
  </block>
</view>

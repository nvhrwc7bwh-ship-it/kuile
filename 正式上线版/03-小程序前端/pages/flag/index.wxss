/* 亏了 · Flag 详情页专属样式 */

/* 头部 */
.head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #1F5F4E;
  color: #FFFFFF;
  font-size: 30rpx;
  text-align: center;
  line-height: 72rpx;
  flex-shrink: 0;
}

.who {
  flex: 1;
  min-width: 0;
}

.who-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.who-sub {
  display: block;
  font-size: 23rpx;
  color: #6B6560;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  margin-bottom: 10rpx;
}

.reason {
  display: block;
  font-size: 26rpx;
  color: #6B6560;
  margin-bottom: 24rpx;
}

/* 数字 */
.nums {
  display: flex;
  margin-bottom: 20rpx;
}

.n {
  flex: 1;
  text-align: center;
}

.n-v {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #1F5F4E;
}

.n-k {
  display: block;
  font-size: 21rpx;
  color: #6B6560;
}

.progress {
  height: 12rpx;
  background: #EFECE7;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: #1F5F4E;
}

.prog-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

/* 卡片头 */
.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

/* 见证席 */
.witness-list {
  margin-top: 8rpx;
}

.witness {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 0;
}

.w-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #EFECE7;
  color: #1F5F4E;
  font-size: 24rpx;
  text-align: center;
  line-height: 56rpx;
  flex-shrink: 0;
}

.w-name {
  flex: 1;
  font-size: 26rpx;
}

.quorum {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(194, 87, 26, 0.08);
  color: #C2571A;
  font-size: 24rpx;
}

/* 节点 */
.nodes {
  margin-top: 8rpx;
}

.node {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}

.node-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 10rpx;
  background: #E5E1DB;
  flex-shrink: 0;
}

.node-dot.done { background: #1F5F4E; }
.node-dot.now { background: #C2571A; }
.node-dot.rejected { background: #B3261E; }

.node-info {
  flex: 1;
}

.node-name {
  display: block;
  font-size: 27rpx;
  font-weight: 500;
}

.node-sub {
  display: block;
  font-size: 22rpx;
  color: #6B6560;
}

.node-w {
  font-size: 26rpx;
  color: #1F5F4E;
  font-weight: 600;
}

/* 留言 */
.msg-list {
  margin: 8rpx 0 20rpx;
}

.msg {
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F0EDE8;
}

.msg-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.msg-name {
  font-size: 25rpx;
  font-weight: 600;
  color: #1F5F4E;
}

.msg-text {
  display: block;
  font-size: 27rpx;
  margin-top: 6rpx;
  line-height: 1.55;
}

.msg-reply {
  margin-top: 10rpx;
  padding: 14rpx 18rpx;
  background: #F5F2EE;
  border-radius: 12rpx;
  font-size: 25rpx;
}

.msg-reply-name {
  color: #1F5F4E;
  font-weight: 600;
}

.msg-act {
  font-size: 23rpx;
  color: #6B6560;
  margin-top: 8rpx;
}

.msg-input {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.m-input {
  flex: 1;
  height: 72rpx;
  border: 2rpx solid #E5E1DB;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}

/* 回复弹层 */
.reply-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.reply-box {
  width: 100%;
  background: #F7F5F2;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.reply-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.reply-box .textarea {
  margin-bottom: 20rpx;
}

/* 亏了 · 记录卡专属样式 */

.banner {
  padding: 56rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.banner.ok { background: rgba(31, 95, 78, 0.08); }
.banner.no { background: rgba(179, 38, 30, 0.06); }

.banner-icon {
  display: block;
  font-size: 88rpx;
  margin-bottom: 16rpx;
}

.banner-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.banner.ok .banner-title { color: #1F5F4E; }
.banner.no .banner-title { color: #B3261E; }

.banner-sub {
  display: block;
  font-size: 26rpx;
  color: #6B6560;
}

.nums {
  display: flex;
  margin: 24rpx 0;
}

.n {
  flex: 1;
  text-align: center;
}

.n-v {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1F5F4E;
}

.n-k {
  display: block;
  font-size: 21rpx;
  color: #6B6560;
}

.kv {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #F0EDE8;
  font-size: 26rpx;
}

.kv:last-child { border-bottom: none; }
.k { color: #6B6560; }
.v { font-weight: 500; }

/* 头像墙 */
.wall {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 12rpx;
}

.w {
  text-align: center;
  width: 100rpx;
}

.w-a {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #1F5F4E;
  color: #FFFFFF;
  font-size: 30rpx;
  text-align: center;
  line-height: 80rpx;
  margin: 0 auto 8rpx;
}

.w-n {
  display: block;
  font-size: 21rpx;
  color: #6B6560;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quote {
  display: block;
  font-size: 30rpx;
  line-height: 1.6;
  text-align: center;
  color: #1F5F4E;
  font-style: italic;
}

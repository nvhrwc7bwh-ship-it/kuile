/* 亏了 · 立 Flag 页专属样式 */

/* 步骤指示 */
.steps {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx 32rpx;
}

.step {
  font-size: 24rpx;
  color: #9A938A;
  white-space: nowrap;
}

.step.on {
  color: #1F5F4E;
  font-weight: 600;
}

.step-line {
  flex: 1;
  height: 2rpx;
  background: #E5E1DB;
  margin: 0 16rpx;
}

.step-line.on {
  background: #1F5F4E;
}

/* 周期列表 */
.period-list {
  margin-top: 8rpx;
}

.period {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F0EDE8;
}

.period:last-child {
  border-bottom: none;
}

.period.on .period-days {
  color: #1F5F4E;
  font-weight: 700;
}

.period.off {
  opacity: 0.45;
}

.period-days {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.period-sub {
  display: block;
  font-size: 23rpx;
  color: #6B6560;
  margin-top: 4rpx;
}

.period-free {
  display: inline-block;
  margin-top: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(31, 95, 78, 0.10);
  color: #1F5F4E;
  font-size: 21rpx;
}

.period-right {
  text-align: right;
}

.period-dep {
  display: block;
  font-size: 26rpx;
  color: #6B6560;
}

.period-off {
  display: block;
  font-size: 21rpx;
  color: #C2571A;
  margin-top: 4rpx;
}

/* 押金 */
.deposit-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.deposit {
  width: calc(50% - 8rpx);
  height: 92rpx;
  border: 2rpx solid #E5E1DB;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.deposit.on {
  border-color: #1F5F4E;
  background: rgba(31, 95, 78, 0.06);
}

.deposit.off {
  opacity: 0.4;
}

.deposit-label {
  font-size: 30rpx;
  font-weight: 600;
}

.deposit-off {
  font-size: 20rpx;
  color: #C2571A;
}

/* 新人保护 */
.free-box {
  padding: 28rpx;
  background: rgba(31, 95, 78, 0.06);
  border-radius: 16rpx;
}

.free-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F5F4E;
}

.free-sub {
  display: block;
  font-size: 24rpx;
  color: #6B6560;
  margin-top: 6rpx;
}

/* 键值行 */
.kv {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #F0EDE8;
  font-size: 26rpx;
}

.kv:last-child {
  border-bottom: none;
}

.k {
  color: #6B6560;
  flex-shrink: 0;
}

.v {
  text-align: right;
  margin-left: 24rpx;
}

.tip {
  display: block;
  margin-top: 16rpx;
}

.back-btn {
  margin-top: 20rpx;
}

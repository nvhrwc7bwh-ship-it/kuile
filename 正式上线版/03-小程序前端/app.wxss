.tabbar{
  flex:0 0 auto;height:inherit;
  background:#NANNANNAN;

  border-top:2rpx solid inherit;
  display:flex;align-items:center;position:relative;z-index:25;
  padding-bottom:env(safe-area-inset-bottom);
}
.tab{
  flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:6rpx;font-size:21rpx;color:inherit;height:100%;position:relative;
  transition:color .18s;
}

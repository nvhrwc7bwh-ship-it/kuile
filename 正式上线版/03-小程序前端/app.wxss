.rc-poster .rc-counts{margin:28rpx 44rpx 0;}
.rcb-dog{object-fit:contain;flex:0 0 auto;display:block;}
.rc-badge{
  position:absolute;right:32rpx;top:30rpx;z-index:2;
  display:flex;align-items:center;gap:10rpx;
  padding:6rpx 18rpx 6rpx 12rpx;border-radius:200rpx;
  background:rgba(255,255,255,.16);border:2rpx solid rgba(255,255,255,.24);

.dep-pick{
  /* ⚠️ 2026-11-25（本轮，用户口径）：卡片内顺序改成
        **金额 → 说明文字 → 选中小圈**（圆圈在最下面）。
     —— 竖排（flex-direction: column）+ 水平居中。
        金额是主体，说明文字是金额的注解，圆圈是选中徽记（最后一层）。
     —— ⚠️ 用 flex-start + 小圈 margin-top:auto：
        各卡的行数不同（0 元档有「首次免费」、锁定档有「信用分不够」、
        普通档只有金额），若整体垂直居中，圆圈会落在不同高度、参差不齐。
        改成【金额顶部对齐、圆圈贴底】，一排圆圈在同一条水平线上。 */
  display:flex;flex-direction:column;align-items:center;justify-content:flex-start;
  gap:10rpx;padding:22rpx 12rpx;
  background:inherit;border:3rpx solid inherit;border-radius:inherit;
  transition:.18s inherit;box-shadow:inherit;
  /* ⚠️ 宽高一致 —— 同一行里每个框都一样高 */
  min-height:156rpx;box-sizing:border-box;
}
.dep-pick.on{border-color:inherit;background:inherit;box-shadow:inherit;}
.dep-pick:active{transform:scale(.985);}
.dep-pick.lock{background:inherit;border-color:inherit;box-shadow:none;opacity:.62;cursor:not-allowed;}
.dep-pick.lock:active{transform:none;}
.dep-pick.lock .dep-v{color:inherit;}
.dep-radio{
  width:36rpx;height:36rpx;border-radius:50%;border:4rpx solid inherit;flex:0 0 36rpx;
  display:flex;align-items:center;justify-content:center;transition:.16s;
  /* ⚠️ 2026-11-25（本轮）：圆圈移到卡片最下面 → 靠 margin-top:auto 贴底，
     这样一排卡片的圆圈在同一条水平线上（各卡行数不同也不会参差）。 */
  margin-top:auto;
}
.dep-pick.on .dep-radio{border-color:inherit;}
.dep-pick.on .dep-radio::after{content:"";width:18rpx;height:18rpx;border-radius:50%;background:inherit;}
.dep-grid.g5 .dep-s{font-size:20rpx;margin-top:0;line-height:1.3;}

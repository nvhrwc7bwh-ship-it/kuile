  letter-spacing:1.2rpx;width:60rpx;
}
.rc-proud-row .rpp-v{
  flex:0 0 auto;font-family:inherit;font-size:30rpx;font-weight:750;
  letter-spacing:-0.8rpx;color:inherit;
}
.rc-proud-row .rpp-d{
  flex:1;min-width:0;font-size:23rpx;color:inherit;text-align:right;
}
.rc-counts{
  display:grid;grid-template-columns:repeat(4,1fr);gap:16rpx;margin-top:24rpx;
}
.rc-count{
  display:flex;flex-direction:column;align-items:center;gap:4rpx;

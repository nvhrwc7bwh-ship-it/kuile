  padding:52rpx 0;text-align:center;font-size:26rpx;color:inherit;
}
.ms-input{
  display:flex;align-items:center;gap:18rpx;
  position:sticky;bottom:0;
  padding:24rpx 0 4rpx;
  background:inherit;
  border-top:2rpx solid inherit;
}
.ms-input .input{flex:1;min-width:0;}
.feed-strip{
  display:flex;gap:8rpx;padding:20rpx 26rpx 0;overflow:hidden;
}
.fs-cell{
  flex:1;min-width:0;aspect-ratio:1;border-radius:16rpx;overflow:hidden;
  background:inherit;position:relative;
}
.fs-cell img{width:100%;height:100%;object-fit:cover;display:block;}
.fs-cell.miss{

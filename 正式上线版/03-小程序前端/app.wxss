}
.fs-cell.makeup{box-shadow:inset 0 0 0 3rpx inherit;}
.fs-cell.future{opacity:.35;}
.fs-cell.last{box-shadow:inset 0 0 0 4rpx inherit;}
.fs-badge{
  position:absolute;top:2rpx;right:2rpx;
  font-size:16rpx;font-weight:800;line-height:1;
  background:inherit;color:#fff;padding:3rpx 6rpx;border-radius:6rpx;
}
.fs-cell.seen{box-shadow:inset 0 0 0 4rpx #3F7A58;}
.feed-head{display:flex;align-items:center;gap:16rpx;padding:22rpx 26rpx 0;}
.feed-name{font-size:26rpx;font-weight:600;}
.feed-meta{font-size:21rpx;color:inherit;margin-top:2rpx;}
.feed-weight{display:flex;align-items:center;gap:20rpx;padding:18rpx 26rpx 18rpx;}
.feed-weight .fw-cur{display:flex;align-items:baseline;gap:4rpx;}
.feed-weight .fw-v{
  font-family:inherit;font-size:54rpx;font-weight:760;letter-spacing:-2.4rpx;line-height:1;
}
.feed-weight .fw-u{font-size:23rpx;color:inherit;font-weight:550;}
.feed-weight .fw-side{
  padding-left:20rpx;border-left:2rpx solid inherit;line-height:1.35;
}
.feed-weight .fw-l{font-size:20rpx;color:inherit;}
.feed-weight .fw-d{font-size:24rpx;font-weight:650;color:inherit;margin-top:2rpx;}
.feed-weight .fw-d.good{color:inherit;}
.feed-weight .fw-prog{flex:1;min-width:0;padding-left:8rpx;}
.feed-weight .fw-prog .bar{margin-bottom:8rpx;}
.feed-weight .fw-prog-l{font-size:20rpx;color:inherit;text-align:right;font-variant-numeric:tabular-nums;}
.feed-foot{
  display:flex;align-items:center;justify-content:space-between;
  padding:16rpx 26rpx;background:inherit;border-top:2rpx solid inherit;
}
.feed-foot .ff-l{font-size:23rpx;color:inherit;display:flex;align-items:center;gap:8rpx;}
.feed-foot .ff-r{font-size:23rpx;color:inherit;font-weight:600;display:flex;align-items:center;gap:6rpx;}
.feed-cancel{
  padding:0 26rpx 20rpx;background:inherit;
  border-top:2rpx solid inherit;
}
.cancel-link{
  background:none;border:none;padding:14rpx 0 0;margin:0;cursor:pointer;
  font-family:inherit;font-size:23rpx;font-weight:500;
  color:inherit;letter-spacing:0.2rpx;
  text-decoration:underline;text-decoration-color:transparent;
  text-underline-offset:6rpx;transition:.15s inherit;
}
.cancel-link:active{color:inherit;text-decoration-color:currentColor;opacity:.75;}
.fd-cancel{
  display:flex;align-items:center;gap:18rpx;flex-wrap:wrap;
  padding:8rpx 4rpx 0;}
.fd-cancel .cancel-link{padding-top:0;}
.fd-cancel-hint{font-size:22rpx;color:inherit;}
.fd-cancel{display:block;text-align:center;padding:12rpx 4rpx 0;}
.fd-cancel .cancel-link{display:block;margin:0 auto;}
.fd-cancel-hint{display:block;text-align:center;font-size:22rpx;color:inherit;margin-top:4rpx;}
.metric-tap{
  background:none;border:0;font:inherit;color:inherit;cursor:pointer;
  display:block;width:100%;
}
.metric-tap .m-l{display:flex;align-items:center;justify-content:center;gap:4rpx;}
.metric-tap .m-l svg{width:22rpx;height:22rpx;color:inherit;}
.metric-tap:active .m-l{color:inherit;}
.tl-tap{
  background:none;border:0;padding:0;font:inherit;color:inherit;cursor:pointer;
  display:inline-flex;align-items:center;gap:8rpx;text-align:left;
}
.tl-tap svg{width:24rpx;height:24rpx;color:inherit;flex:0 0 auto;}
.tl-tap:active{color:inherit;}
.vd-sum{margin-top:28rpx;border-top:2rpx solid inherit;padding-top:24rpx;}
.vd-sum-row{display:flex;align-items:center;gap:18rpx;padding:14rpx 0;}
.vd-sum-row + .vd-sum-row{border-top:2rpx solid inherit;}
.vd-sum-ico{width:44rpx;height:44rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:0 0 44rpx;}
.vd-sum-ico svg{width:26rpx;height:26rpx;}
.vd-sum-ico.mint{background:inherit;color:inherit;}
.vd-sum-ico.amber{background:inherit;color:#A97108;}
.vd-sum-ico.rose{background:inherit;color:inherit;}
.vd-sum-k{flex:1;font-size:27rpx;font-weight:600;}
.vd-sum-v{font-size:27rpx;font-weight:700;font-family:inherit;}
.fm-cancel{
  display:flex;align-items:center;gap:18rpx;flex-wrap:wrap;
  padding:28rpx 4rpx 0;margin-top:4rpx;
  border-top:2rpx solid inherit;
}
.fm-cancel .cancel-link{padding-top:0;}
.status-pill{
  display:inline-flex;align-items:center;gap:8rpx;padding:6rpx 16rpx;border-radius:200rpx;
  font-size:21rpx;font-weight:650;
}
.status-pill .pulse{width:12rpx;height:12rpx;border-radius:50%;background:currentColor;animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.45;transform:scale(.82);}}
.status-pill.live{background:inherit;color:#3F7A58;}
.status-pill.soon{background:inherit;color:#A97108;}
.status-pill.broke{background:inherit;color:#B03B40;}
.status-pill.done{background:inherit;color:inherit;}
.timeline{padding:4rpx 0;}
.tl{display:flex;gap:28rpx;position:relative;padding-bottom:40rpx;}
.tl:last-child{padding-bottom:0;}
.tl::before{content:"";position:absolute;left:18rpx;top:44rpx;bottom:0;width:4rpx;background:inherit;border-radius:4rpx;}
.tl:last-child::before{display:none;}
.tl-dot{
  width:40rpx;height:40rpx;border-radius:50%;border:6rpx solid inherit;
  background:inherit;flex:0 0 40rpx;margin-top:4rpx;z-index:1;transition:.2s;
}
.tl.done .tl-dot{background:inherit;border-color:inherit;}
.tl.now .tl-dot{border-color:inherit;box-shadow:0 0 0 8rpx inherit,0 4rpx 12rpx rgba(169,79,12,.22);}
.tl.fail .tl-dot{background:inherit;border-color:inherit;}
.tl.skip .tl-dot{background:inherit;border-color:inherit;border-style:dashed;}
.tl.skip .tl-t{color:inherit;font-weight:560;}
.tl.skip .tl-d{color:inherit;}
.tl-body{flex:1;min-width:0;padding-top:2rpx;}
.tl-t{font-size:29rpx;font-weight:620;letter-spacing:-0.2rpx;}
.tl-d{font-size:24rpx;color:inherit;margin-top:4rpx;}
.tl.mine .tl-dot{
  width:52rpx;height:52rpx;flex:0 0 52rpx;margin-top:-4rpx;
  border-color:inherit;background:inherit;color:#fff;
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 0 0 10rpx inherit,0 4rpx 16rpx rgba(169,79,12,.26);
}
.tl.mine .tl-t{color:inherit;font-weight:720;}
.photo-strip{
  display:flex;gap:12rpx;overflow-x:auto;padding:20rpx 26rpx 4rpx;
  scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch;
}
.ps-cell{
  flex:0 0 156rpx;height:156rpx;border-radius:22rpx;overflow:hidden;position:relative;
  background:inherit;scroll-snap-align:start;
}
.ps-cell img{width:100%;height:100%;object-fit:cover;display:block;}
.ps-cell.miss{
  background:inherit;
  background-image:repeating-linear-gradient(45deg,rgba(0,0,0,.045) 0 6rpx,transparent 6rpx 12rpx);
}
.ps-cell.makeup{box-shadow:inset 0 0 0 4rpx inherit;}
.ps-d{
  position:absolute;left:0;bottom:0;right:0;padding:16rpx 8rpx 6rpx;text-align:center;

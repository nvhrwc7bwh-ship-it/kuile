  font-size:20rpx;font-weight:700;line-height:32rpx;text-align:center;
  vertical-align:2rpx;
}
.notif-seg button.on .seg-n{background:inherit;}
.notif-list{
  padding:0 32rpx 40rpx;display:flex;flex-direction:column;gap:12rpx;
}
.swipe{
  position:relative;overflow:hidden;border-radius:inherit;
  touch-action:pan-y;
}
.swipe-del{
  position:absolute;top:0;right:0;bottom:0;width:152rpx;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx;

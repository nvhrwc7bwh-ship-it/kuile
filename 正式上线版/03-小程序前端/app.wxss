  background:linear-gradient(transparent,rgba(0,0,0,.55));
}
.ev-badge{
  position:absolute;top:20rpx;left:20rpx;
  background:inherit;color:#fff;font-size:21rpx;font-weight:750;
  padding:6rpx 16rpx;border-radius:200rpx;
}
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:10rpx;}
.cal-h{font-size:21rpx;color:inherit;text-align:center;padding-bottom:8rpx;font-weight:600;}
.cal-d{
  aspect-ratio:1;border-radius:18rpx;background:inherit;
  display:flex;align-items:center;justify-content:center;
  font-size:23rpx;color:inherit;font-weight:550;transition:.15s;
}
.cal-d.done{background:inherit;color:inherit;font-weight:700;}
.cal-d.today{box-shadow:0 0 0 4rpx inherit,0 4rpx 12rpx rgba(169,79,12,.18);font-weight:700;color:inherit;}
.cal-d.miss{background:inherit;color:inherit;font-weight:700;}
.cal-d.makeup{background:inherit;color:#A97108;font-weight:700;position:relative;}
.cal-d.makeup::after{content:"补";position:absolute;top:2rpx;right:6rpx;font-size:16rpx;font-weight:800;opacity:.85;}
.cal-d.void{background:repeating-linear-gradient(45deg,inherit 0 8rpx,inherit 8rpx 16rpx);color:inherit;}
.cal-d.future{opacity:.42;}
.cal-legend{display:flex;gap:28rpx;margin-top:24rpx;flex-wrap:wrap;font-size:23rpx;color:inherit;}
.cal-legend i{display:inline-block;width:20rpx;height:20rpx;border-radius:6rpx;margin-right:10rpx;vertical-align:-2rpx;}
.cal-lite .cal-d{background:inherit;color:inherit;}
.cal-lite .cal-d.done{background:inherit;color:inherit;font-weight:550;}
.cal-lite .cal-d.makeup{background:inherit;color:inherit;font-weight:550;}
.cal-lite .cal-d.makeup::after{display:none;}
.cal-lite .cal-d.future{opacity:.42;}
.cal-lite .cal-d.brk{
  background:inherit;color:inherit;font-weight:750;position:relative;
}
.cal-lite .cal-d.brk::after{
  content:"";position:absolute;top:6rpx;right:8rpx;
  width:10rpx;height:10rpx;border-radius:50%;background:inherit;
}
.cal-lite .cal-d.today{box-shadow:0 0 0 4rpx inherit;color:inherit;font-weight:700;}
.cal-legend i.cal-dot-mark{
  display:inline-block;width:16rpx;height:16rpx;border-radius:50%;
  background:inherit;margin-right:10rpx;vertical-align:0rpx;
}
.cal-brk{
  font-size:23rpx;color:inherit;font-weight:600;
  margin-left:auto;padding:0 16rpx;
}
.brk-card.danger .cal-brk{color:inherit;}
.brk-card.dead .cal-brk{color:inherit;}
.cal-fold-btn{
  padding:26rpx 28rpx;font-size:26rpx;color:inherit;font-weight:650;
  justify-content:space-between;
}
.cal-fold-btn svg{width:30rpx;height:30rpx;color:inherit;}
.fold .cal{padding:0 28rpx 8rpx;}
.fold .cal-legend{padding:0 28rpx 28rpx;margin-top:24rpx;}
.receipt{
  border-radius:inherit;overflow:hidden;box-shadow:inherit;
  background:linear-gradient(160deg,#fff 0%,#FAF8F5 100%);
  position:relative;
}
.receipt-head{
  background:linear-gradient(150deg,inherit,inherit);
  color:#fff;padding:48rpx 44rpx 44rpx;position:relative;overflow:hidden;
}
.receipt-head::after{
  content:"";position:absolute;right:-100rpx;top:-100rpx;width:340rpx;height:340rpx;
  border-radius:50%;background:rgba(255,255,255,.07);
}
.receipt-head .rc-kicker{font-size:23rpx;opacity:.75;letter-spacing:2.4rpx;font-weight:600;position:relative;z-index:1;}
.receipt-head .rc-title{font-size:44rpx;font-weight:730;margin:16rpx 0 10rpx;letter-spacing:-1rpx;line-height:1.3;position:relative;z-index:1;}
.receipt-head .rc-sub{font-size:25rpx;opacity:.78;position:relative;z-index:1;}
.receipt-body{padding:40rpx 44rpx 44rpx;}
.receipt-weight{display:flex;align-items:baseline;gap:18rpx;justify-content:center;margin-bottom:32rpx;}
.receipt-weight .w-from{font-family:inherit;font-size:34rpx;color:inherit;text-decoration:line-through;}
.receipt-weight .w-arrow{color:inherit;font-size:30rpx;}
.receipt-weight .w-to{font-family:inherit;font-size:76rpx;font-weight:780;letter-spacing:-4rpx;color:inherit;}
.receipt-weight .w-unit{font-size:28rpx;color:inherit;font-weight:500;}
.receipt-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx;}
.receipt-stat{text-align:center;padding:22rpx 8rpx;background:inherit;border-radius:inherit;}
.receipt-stat .rs-v{font-family:inherit;font-size:38rpx;font-weight:750;letter-spacing:-1.4rpx;}
.receipt-stat .rs-l{font-size:21rpx;color:inherit;margin-top:6rpx;}
.receipt-foot{
  padding:28rpx 44rpx 40rpx;display:flex;align-items:center;justify-content:space-between;
  border-top:2rpx solid inherit;
}
.receipt-quote{

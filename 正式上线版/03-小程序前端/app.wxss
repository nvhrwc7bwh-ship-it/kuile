.rc-brand{
  display:flex;align-items:center;justify-content:center;gap:14rpx;
  padding:30rpx 44rpx 32rpx;margin-top:4rpx;
}
.rc-brand .rcb-dog{width:40rpx;height:40rpx;}
.rc-brand .rcb-name{
  font-size:26rpx;font-weight:750;letter-spacing:6rpx;color:inherit;line-height:1;
}
.rc-brand .rcb-sep{width:2rpx;height:22rpx;background:inherit;flex:0 0 2rpx;}
.rc-brand .rcb-slogan{font-size:23rpx;color:inherit;letter-spacing:0.6rpx;line-height:1;}
.share-sheet .sheet-body{

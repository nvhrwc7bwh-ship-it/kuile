  position:relative;background:inherit;
  cursor:pointer;transition:.16s inherit;
}
.tr-cell.tr-empty{
  background:transparent;
  border:2rpx dashed inherit;
  cursor:default;
}
.tr-cell:active{transform:scale(.96);}
.tr-cell img{width:100%;height:100%;object-fit:cover;display:block;}
.tr-d{
  position:absolute;left:0;bottom:0;right:0;padding:20rpx 8rpx 6rpx;text-align:center;
  font-size:18rpx;font-weight:700;color:#fff;
  background:linear-gradient(transparent,rgba(0,0,0,.55));
}
.pv-link{
  background:none;border:none;color:inherit;font-size:25rpx;font-weight:600;
  padding:8rpx 16rpx;cursor:pointer;margin:4rpx 0;
}
.ev-photo{
  position:relative;border-radius:inherit;overflow:hidden;
  aspect-ratio:1;background:inherit;
}
.ev-photo img{width:100%;height:100%;object-fit:cover;display:block;}
.ev-photo.ev-miss{
  aspect-ratio:auto;height:380rpx;display:flex;flex-direction:column;
  align-items:center;justify-content:center;color:#fff;
  background:linear-gradient(150deg,#FF8A2B 0%,#FF6B00 60%,#E85A00 100%);
}
.ev-wm{
  position:absolute;left:0;right:0;bottom:0;padding:32rpx 24rpx 18rpx;

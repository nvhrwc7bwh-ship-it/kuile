}
.rc-count .rcc-ico{color:inherit;display:flex;}
.rc-count .rcc-v{font-family:inherit;font-size:32rpx;font-weight:750;letter-spacing:-1rpx;}
.rc-count .rcc-l{font-size:21rpx;color:inherit;}
.rc-poster{
  border-radius:inherit;

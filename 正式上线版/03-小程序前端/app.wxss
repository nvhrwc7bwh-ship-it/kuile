*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;}
body{
  margin:0;font-family:inherit;background:#E9E6E1;color:inherit;
  font-size:30rpx;line-height:1.5;-webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
  font-variant-numeric:tabular-nums;
}
button{font-family:inherit;font-size:inherit;border:0;background:none;cursor:pointer;color:inherit;padding:0;}
ul,ol{margin:0;padding:0;list-style:none;}
h1,h2,h3,h4,p{margin:0;font-weight:inherit;}
a{color:inherit;text-decoration:none;}
img{max-width:100%;}
input,textarea,select{font-family:inherit;}
.screen-scroll{
  position:absolute;inset:0;overflow-y:auto;overflow-x:hidden;
  -webkit-overflow-scrolling:touch;overscroll-behavior-y:contain;
  scrollbar-width:none;
}
.page{
  padding:0 36rpx calc(56rpx + env(safe-area-inset-bottom));
  animation:pageIn .34s inherit both;
}
@keyframes pageIn{from{opacity:0;transform:translateY(16rpx) scale(.995);}to{opacity:1;transform:none;}}
.page.pop{animation:pagePop .3s inherit both;}
@keyframes pagePop{from{opacity:0;transform:scale(.94);}to{opacity:1;transform:none;}}
.nav{
  position:sticky;top:0;z-index:20;
  background:#NANNANNAN;

  padding:12rpx 36rpx 16rpx;
}
.nav-row{
  height:inherit;display:flex;align-items:center;gap:20rpx;
  transition:height .22s inherit;
}
.nav-back{
  width:64rpx;height:64rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;
  background:rgba(17,19,24,.05);transition:.15s;flex:0 0 64rpx;
}
.nav-back:active{background:rgba(17,19,24,.12);transform:scale(.92);}
.nav-back svg{width:32rpx;height:32rpx;}
.nav-title{
  font-size:33rpx;font-weight:650;letter-spacing:0.4rpx;flex:1;min-width:0;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  opacity:0;transform:translateY(8rpx);transition:.22s inherit;
}
.nav-title.big{opacity:1;transform:none;font-size:58rpx;font-weight:760;letter-spacing:-1.4rpx;line-height:1.2;}
.nav.scrolled .nav-title{opacity:1;transform:none;}
.nav.scrolled .nav-row{height:88rpx;}
.nav.scrolled .nav-title.big{font-size:33rpx;font-weight:650;letter-spacing:0.4rpx;}
.nav-actions{display:flex;gap:12rpx;align-items:center;}
.nav-id-slot{
  display:flex;align-items:center;min-width:0;flex:0 1 auto;
  margin-left:4rpx;margin-right:-4rpx;
}
.nav-id{
  display:flex;align-items:center;gap:10rpx;min-width:0;
  font-size:24rpx;color:inherit;line-height:1;
}
.nav-id .avatar{margin-right:2rpx;}
.nav-id-name{font-weight:650;color:inherit;white-space:nowrap;}
.nav-id-days,.nav-id-tier{white-space:nowrap;}
.nav-id-tier{color:inherit;}
.nav-id-sep{color:inherit;opacity:.6;}
.nav-id.tap{cursor:pointer;-webkit-user-select:none;user-select:none;}
.nav-id.tap:active{opacity:.6;}
.nav-id.tap:hover .nav-id-name{color:inherit;}
.nav-tier-slot{
  display:flex;align-items:center;min-width:0;flex:0 0 auto;
  margin-left:auto;
}
.nav-tier{
  display:flex;align-items:center;gap:10rpx;
  font-size:23rpx;color:inherit;line-height:1;white-space:nowrap;
}
.nav-tier-days{font-weight:600;color:inherit;}
.nav-tier-name{color:inherit;}
.nav-tier-dep{font-weight:700;color:inherit;font-variant-numeric:tabular-nums;}
.nav-tier-t{
  font-weight:700;color:inherit;font-size:22rpx;letter-spacing:0.6rpx;
  padding:2rpx 12rpx;border-radius:12rpx;background:inherit;
}
.nav.scrolled .nav-id{display:none;}
.nav-btn{
  width:68rpx;height:68rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;
  background:rgba(17,19,24,.05);transition:.15s;position:relative;flex:0 0 68rpx;
}
.nav-btn:active{transform:scale(.9);background:rgba(17,19,24,.11);}
.nav-btn svg{width:36rpx;height:36rpx;}
.nav-btn .badge{
  position:absolute;top:4rpx;right:4rpx;min-width:32rpx;height:32rpx;padding:0 8rpx;
  background:inherit;color:#fff;border-radius:200rpx;font-size:20rpx;font-weight:700;
  display:flex;align-items:center;justify-content:center;border:4rpx solid inherit;
}
.nav-btn.wide{
  width:auto;height:60rpx;padding:0 22rpx;border-radius:200rpx;gap:10rpx;
  font-size:25rpx;font-weight:600;color:inherit;
  background:inherit;border:2rpx solid inherit;
}
.nav-btn.wide:active{transform:scale(.96);}
.nav-btn.wide svg{width:30rpx;height:30rpx;}
.nav-btn.icon-only{
  width:68rpx;height:68rpx;border-radius:50%;
  background:rgba(17,19,24,.05);
}
.nav-btn.icon-only svg{width:36rpx;height:36rpx;}

/* 底部半屏抽屉 —— 对应 demo 的 #sheet */

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.48);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  animation: sheetFadeIn 0.22s ease-out;
}

@keyframes sheetFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.sheet-body {
  width: 100%;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 82vh;
  overflow-y: auto;
  animation: sheetSlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
}

@keyframes sheetSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #F0E9E1;
  margin: 16rpx auto 8rpx;
}

.sheet-head {
  position: relative;
  padding: 20rpx 0 24rpx;
}

.sheet-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1C1613;
  line-height: 1.3;
  padding-right: 72rpx;
}

.sheet-sub {
  display: block;
  font-size: 24rpx;
  color: #857A6F;
  margin-top: 8rpx;
  line-height: 1.5;
  padding-right: 72rpx;
}

.sheet-close {
  position: absolute;
  right: -8rpx;
  top: 12rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #F0E9E1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-close:active {
  transform: scale(0.9);
}

.sheet-close-x {
  font-size: 26rpx;
  color: #4A423B;
  line-height: 1;
}

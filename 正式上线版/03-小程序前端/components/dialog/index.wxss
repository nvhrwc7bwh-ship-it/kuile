/* 居中弹窗 —— 对应 demo 的 dialog() */

.dlg-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.48);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  animation: dlgFadeIn 0.18s ease-out;
}

@keyframes dlgFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.dlg {
  width: 100%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 32rpx 28rpx;
  box-shadow: 0 32rpx 96rpx rgba(74, 52, 32, 0.16);
  animation: dlgPop 0.24s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes dlgPop {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}

.dlg-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1C1613;
  text-align: center;
  line-height: 1.35;
  margin-bottom: 20rpx;
}

.dlg-body {
  display: block;
  font-size: 27rpx;
  color: #4A423B;
  line-height: 1.75;
  margin-bottom: 32rpx;
  white-space: pre-wrap;
}

/* 富文本正文 */
.dlg rich-text {
  display: block;
  font-size: 27rpx;
  color: #4A423B;
  line-height: 1.75;
  margin-bottom: 32rpx;
}

.dlg-acts {
  display: flex;
  gap: 20rpx;
}

.dlg-btn {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
}

/* 危险操作（取消 Flag 等）—— 红色描边，不抢主色 */
.dlg .btn-danger {
  background: transparent;
  color: #C9302D;
  border: 2rpx solid #F0413E;
  box-shadow: none;
}
